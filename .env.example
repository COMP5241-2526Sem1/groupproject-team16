# 数据库配置
DATABASE_URL="postgresql://username:password@localhost:5432/agent_edu_db"

# JWT密钥 (生产环境请使用强密钥)
JWT_SECRET="your-super-secret-jwt-key-here"

# 服务器端口
PORT=3001

# Node环境
NODE_ENV="development"

# Vercel Postgres 配置 (部署时由Vercel自动提供)
# POSTGRES_URL=""
# POSTGRES_PRISMA_URL=""
# POSTGRES_URL_NO_SSL=""
# POSTGRES_URL_NON_POOLING=""
# POSTGRES_USER=""
# POSTGRES_HOST=""
# POSTGRES_PASSWORD=""
# POSTGRES_DATABASE=""

# 文件上传配置
UPLOAD_MAX_SIZE="10485760"  # 10MB
UPLOAD_ALLOWED_TYPES="image/jpeg,image/png,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"

# API接口配置
API_BASE_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:5173"

# Dify Agent 配置 (可选)
DIFY_API_KEY=""
DIFY_BASE_URL="https://api.dify.ai/v1"

# 豆包AI配置
DOUBAO_API_KEY="804d1fe1-4b03-4483-9220-ccdfbffbeffd"
DOUBAO_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
DOUBAO_MODEL="doubao-1-5-lite-32k-250115"

# 邮件服务配置 (可选)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""