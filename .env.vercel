# Vercel 环境变量配置示例

# 前端环境变量（构建时使用）
VITE_API_BASE_URL=/api

# 后端环境变量（运行时使用）
# 数据库连接（已硬编码，无需设置）
# DATABASE_URL=postgresql://neondb_owner:npg_d2jCWZPFSgQ3@ep-red-wave-adt4e4cj-pooler.c-2.us-east-1.aws.neon.tech/agentedu?sslmode=require

# 应用基础 URL（可选，用于文件上传等场景）
# 如果不设置，会自动从请求头中获取
# APP_URL=https://your-app.vercel.app

# JWT 密钥（必需）
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# AI API 密钥（可选，如果使用 AI 功能）
DOUBAO_API_KEY=your-doubao-api-key
OPENAI_API_KEY=your-openai-api-key

# Node 环境
NODE_ENV=production

# 端口（Vercel 自动设置，本地开发使用）
PORT=3001

# Vercel 自动设置的环境变量（无需手动配置）
# VERCEL=1
# VERCEL_ENV=production
# VERCEL_URL=your-deployment-url.vercel.app
